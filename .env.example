# RS Wallet — Next.js runtime configuration
# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase (database + storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-anon-key

# Admin panel access
ADMIN_FALLBACK_EMAIL=admin@rswallet.online
ADMIN_FALLBACK_PASSWORD=change-me
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Public site URL used for canonical links, sitemap and schema
NEXT_PUBLIC_SITE_URL=https://rswallet.online
